# 2. Cloudflare Pages & Functions Security
JWT_SECRET="super-secret-jwt-key-for-justclub-cloudflare-pages"

# 3. Cashfree Payment Gateway Credentials (for Subscription Billing & Club Invoicing)
CASHFREE_ENVIRONMENT="TEST" # "TEST" or "PRODUCTION"
CASHFREE_TEST_APP_ID="TEST1029384756"
CASHFREE_TEST_SECRET_KEY="cfsk_ma_test_sample_secret_key"
CASHFREE_LIVE_APP_ID=""
