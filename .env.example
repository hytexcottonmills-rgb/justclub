# ==============================================================================
# JUSTCLUB OS — Environment Configuration (.env.example)
# ==============================================================================

# 1. Platform & AI Studio Hosting
GEMINI_API_KEY=""
APP_URL=""

# 2. Cloudflare Pages & Functions Security
JWT_SECRET="" # REQUIRED in production. Generate with: openssl rand -base64 48
# Set this in the Cloudflare Pages dashboard under Settings > Environment Variables as a "secret" (encrypted), never commit a real value here.
ALLOWED_ORIGINS="" # Comma-separated list of allowed production/staging domains (e.g. "https://justclub.in,https://www.justclub.in")

# 3. Razorpay Payment Gateway Credentials (for Subscription Billing & Club Invoicing)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""

# 4. Google SSO Credentials (for Google One Tap / Google Sign-In)
# Note: VITE_GOOGLE_CLIENT_ID is used client-side. GOOGLE_CLIENT_ID is used server-side in Cloudflare Pages to validate token audience.
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# 5. Superadmin Allowlist
# Comma-separated list of Google email addresses permitted to be auto-provisioned as superadmin (e.g. "rajaganapathy235@gmail.com").
# REQUIRED as a Cloudflare Pages Functions environment variable in production settings.
ADMIN_EMAILS="rajaganapathy235@gmail.com"

# 6. Cloudflare D1 Database Binding
# In Cloudflare Pages Dashboard > Settings > Functions > D1 database bindings:
# Variable Name: DB
# D1 Database Name: justclub-db
